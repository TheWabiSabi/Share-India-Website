EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
COMPANY_CONTACT_EMAIL=
DISPLAY_EMAIL=

# Ghost CMS (blog) — Content API consumed by the Next.js app.
# GHOST_API_URL is where Ghost is reachable; GHOST_CONTENT_API_KEY comes from
# Ghost Admin -> Settings -> Integrations -> Add custom integration.
GHOST_API_URL=http://localhost:2368
GHOST_CONTENT_API_KEY=

# docker-compose.cms.yml credentials (local Ghost + MySQL 8 stack).
MYSQL_ROOT_PASSWORD=ghost_root
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=ghost_password
